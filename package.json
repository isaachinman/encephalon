{
  "name": "encephalon",
  "version": "0.1.0",
  "description": "Repository-local, durable knowledge for coding agents",
  "keywords": [
    "agents",
    "cli",
    "knowledge",
    "memory",
    "sqlite"
  ],
  "homepage": "https://github.com/isaachinman/encephalon#readme",
  "bugs": {
    "url": "https://github.com/isaachinman/encephalon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaachinman/encephalon.git"
  },
  "license": "MIT",
  "author": "Isaac Hinman",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.3.1",
  "bin": {
    "encephalon": "dist/cli.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "benchmark": "node scripts/benchmark.ts",
    "benchmark:check": "node scripts/benchmark.ts --profile ci --budget docs/performance-budgets.json",
    "build": "bun run scripts/build.ts",
    "check:package": "bun run scripts/check-package.ts",
    "check:publish": "npm publish --dry-run --access public --json",
    "lint": "ultracite check",
    "prepack": "bun run build && bun run check:package",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "7.0.2",
    "ultracite": "7.10.1"
  }
}
