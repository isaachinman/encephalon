{
	"extends": "./tsconfig.src.json",
	"compilerOptions": {
		"declaration": true,
		"declarationDir": "./dist",
		"emitDeclarationOnly": true,
		"noEmit": false,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "./src",
		"stripInternal": true,
		"strictNullChecks": true
	},
	"include": ["src/**/*.ts"]
}
